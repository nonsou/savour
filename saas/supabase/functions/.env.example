# Supabase Edge Function secrets contract for SAVOUR billing (placeholders only; never commit values).
# Set by the operator with `supabase secrets set` on savour-dev. SUPABASE_URL and SUPABASE_ANON_KEY
# are injected by Supabase. The service-role key is never read by these functions.
# Provider API keys and webhook signing secrets are NOT environment variables: platform admins store
# them write-only in Supabase Vault from the Platform admin page.

# Scoped login roles (each role is created NOLOGIN by the migration; the operator enables LOGIN and
# sets a password out of band). Use the pooler connection string for each role.
SAVOUR_BILLING_INTAKE_DB_URL=postgresql://billing_intake.<project-ref>:<password>@<pooler-host>:6543/postgres
SAVOUR_BILLING_WORKER_DB_URL=postgresql://billing_worker.<project-ref>:<password>@<pooler-host>:6543/postgres
SAVOUR_BILLING_GATEWAY_DB_URL=postgresql://billing_gateway.<project-ref>:<password>@<pooler-host>:6543/postgres

# Bearer token shared with the pg_cron job through Vault (at least 32 random characters).
SAVOUR_BILLING_WORKER_TOKEN=<random-token-at-least-32-characters>

# Bare https origin of the protected Preview used for checkout success/cancel URLs and browser CORS.
SAVOUR_APP_ORIGIN=https://<preview-host>
